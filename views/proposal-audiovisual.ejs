<!-- ════════════════════════════════════════════════
     5. ORÇAMENTO
════════════════════════════════════════════════ -->
<section class="section" style="border-top:1px solid #111;">
  <div class="container">

    <div style="margin-bottom:3.5rem;display:flex;align-items:flex-end;gap:1.5rem;flex-wrap:wrap;">
      <div class="sec-num reveal" style="line-height:.85;flex-shrink:0;">05</div>
      <div class="reveal" style="padding-bottom:.35rem;">
        <p class="label" style="margin:0 0 .4rem;">Proposta para <%= proposal.client.company %></p>
        <h2 style="font-size:clamp(1.8rem,4vw,3rem);font-weight:700;text-transform:uppercase;margin:0;line-height:1.1;">Orçamento Audiovisual</h2>
      </div>
    </div>

    <!-- SVG gradient defs -->
    <svg width="0" height="0" style="position:absolute;overflow:hidden;" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="icon-g" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#1400FF"/>
          <stop offset="100%" stop-color="#00CFFF"/>
        </linearGradient>
      </defs>
    </svg>

    <div class="proposal-intro reveal">
      <p style="font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);margin:0 0 .5rem;">Sobre este projeto</p>
      <p style="color:#888;font-size:.95rem;line-height:1.8;margin:0;max-width:720px;">
        <%= proposal.proposalIntro %>
      </p>
    </div>

    <div class="content-cards" id="budget-grid">
      <% proposal.items.forEach((item, idx) => { %>
      <div class="content-card" data-card-idx="<%= idx %>">
        <div class="card-watermark"><%= item.id %></div>

        <div class="card-header">
          <div class="card-icon-wrap">
            <% if (item.icon === 'video') { %>
              <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="1.5" y="5.5" width="17" height="17" rx="2" stroke="url(#icon-g)" stroke-width="1.6"/>
                <path d="M18.5 10.5L26.5 7v14l-8-3.5V10.5z" stroke="url(#icon-g)" stroke-width="1.6" stroke-linejoin="round"/>
                <line x1="6" y1="10" x2="6" y2="18" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
                <line x1="9.5" y1="8" x2="9.5" y2="20" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            <% } else if (item.icon === 'camera') { %>
              <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 9c0-1.1.9-2 2-2h3.5l2.5-3h8l2.5 3H24c1.1 0 2 .9 2 2v14c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V9z" stroke="url(#icon-g)" stroke-width="1.6"/>
                <circle cx="14" cy="16" r="4.5" stroke="url(#icon-g)" stroke-width="1.6"/>
                <circle cx="14" cy="16" r="1.5" fill="url(#icon-g)"/>
                <circle cx="22" cy="10" r="1" fill="url(#icon-g)"/>
              </svg>
            <% } else if (item.icon === 'drone') { %>
              <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="14" cy="14" r="3" stroke="url(#icon-g)" stroke-width="1.6"/>
                <line x1="11.5" y1="11.5" x2="5" y2="5" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
                <line x1="16.5" y1="11.5" x2="23" y2="5" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
                <line x1="11.5" y1="16.5" x2="5" y2="23" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
                <line x1="16.5" y1="16.5" x2="23" y2="23" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
                <circle cx="5" cy="5" r="2.2" stroke="url(#icon-g)" stroke-width="1.4"/>
                <circle cx="23" cy="5" r="2.2" stroke="url(#icon-g)" stroke-width="1.4"/>
                <circle cx="5" cy="23" r="2.2" stroke="url(#icon-g)" stroke-width="1.4"/>
                <circle cx="23" cy="23" r="2.2" stroke="url(#icon-g)" stroke-width="1.4"/>
              </svg>
            <% } else if (item.icon === 'audio') { %>
              <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="10" y="2" width="8" height="15" rx="4" stroke="url(#icon-g)" stroke-width="1.6"/>
                <path d="M6 13v1a8 8 0 0 0 16 0v-1" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
                <line x1="14" y1="22" x2="14" y2="26" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
                <line x1="9" y1="26" x2="19" y2="26" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            <% } else if (item.icon === 'mic') { %>
              <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="10.5" width="18" height="7" rx="3.5" stroke="url(#icon-g)" stroke-width="1.6"/>
                <line x1="24.5" y1="9" x2="24.5" y2="19" stroke="url(#icon-g)" stroke-width="1.6" stroke-linecap="round"/>
                <line x1="6.5" y1="13.5" x2="17.5" y2="14.5" stroke="url(#icon-g)" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
            <% } %>
          </div>
          <h3 class="card-title"><%= item.name %></h3>
        </div>
        <p class="card-subtitle"><%= item.subtitle %></p>

        <div class="card-deliverables">
          <% item.deliverables.forEach(d => { %>
            <div class="check-item">
              <span class="check-icon">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5l3.5 3.5 6.5-7" stroke="#1400FF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span style="color:#ccc;font-size:.88rem;line-height:1.6;"><%= d %></span>
            </div>
          <% }) %>
        </div>

        <div class="card-price-block">
          <div>
            <p class="card-price-label">Quantidade × Valor unitário</p>
            <div class="card-price-calc"><%= item.qty %> <%= item.unitLabel %> × <%= item.unitPrice %></div>
          </div>
          <div style="text-align:right;">
            <p class="card-price-label">Subtotal</p>
            <div class="card-price"><%= item.lineTotal %></div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- Infos importantes -->
    <% if (proposal.infos && proposal.infos.length) { %>
    <div class="infos-block reveal">
      <h4>Infos importantes</h4>
      <% proposal.infos.forEach(info => { %>
        <div class="infos-item"><span class="infos-dot"></span><span><%= info %></span></div>
      <% }) %>
    </div>
    <% } %>

    <!-- Investimento total -->
    <% if (proposal.investment) { %>
    <div class="investment-block">
      <div class="invest-item invest-highlight">
        <p class="invest-label">Investimento total</p>
        <div class="invest-value"><%= proposal.investment.total %></div>
        <p class="invest-sub">Valor completo do projeto</p>
      </div>
      <% if (proposal.investment.cashDiscount) { %>
      <div class="invest-divider"></div>
      <div class="invest-item">
        <p class="invest-label">À vista com desconto</p>
        <div class="invest-value" style="color:var(--cyan);"><%= proposal.investment.cashDiscount %></div>
        <p class="invest-sub">Pagamento único</p>
      </div>
      <% } %>
      <% if (proposal.investment.installments) { %>
      <div class="invest-divider"></div>
      <div class="invest-item">
        <p class="invest-label">Parcelado em até <%= proposal.investment.installments.count %>x</p>
        <div class="invest-value" style="color:var(--cyan);">
          <%= proposal.investment.installments.count %>x de <%= proposal.investment.installments.value %>
        </div>
        <p class="invest-sub">Via <%= proposal.investment.installments.method %></p>
      </div>
      <% } %>
    </div>
    <% } %>

    <div style="text-align:center;margin-top:3rem;">
      <a href="<%= proposal.cta.meetingLink %>" target="_blank"
         class="cta-btn-pulse"
         style="display:inline-block;background:var(--blue);color:#fff;font-family:inherit;font-size:.85rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;padding:.85rem 2.2rem;border-radius:3px;transition:filter 200ms;">
        Quero avançar com esse projeto ↗
      </a>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════
     6. CTA FINAL
════════════════════════════════════════════════ -->
<section class="section" style="border-top:1px solid #111;text-align:center;">
  <div class="container" style="max-width:600px;">
    <p class="label reveal" style="margin-bottom:1rem;">Próximo passo</p>
    <h2 class="reveal" style="font-size:clamp(1.8rem,4vw,3rem);font-weight:700;text-transform:uppercase;margin:0 0 2.5rem;line-height:1.1;">
      Vamos<br><span style="color:var(--cyan);">Conversar?</span>
    </h2>
    <div class="reveal" style="margin-bottom:2rem;">
      <a href="<%= proposal.cta.meetingLink %>" target="_blank" class="cta-btn">Agendar reunião ↗</a>
    </div>
    <div class="reveal" style="color:#444;font-size:.85rem;line-height:2.2;">
      <% if(proposal.cta.whatsapp){%>
        <div>WhatsApp: <a href="https://wa.me/<%= proposal.cta.whatsapp.replace(/\D/g,'') %>" style="color:#666;text-decoration:none;" target="_blank"><%= proposal.cta.whatsapp %></a></div>
      <%}%>
      <% if(proposal.cta.email){%>
        <div>E-mail: <a href="mailto:<%= proposal.cta.email %>" style="color:#666;text-decoration:none;"><%= proposal.cta.email %></a></div>
      <%}%>
    </div>
  </div>
</section>

<footer style="border-top:1px solid #111;padding:2rem;text-align:center;color:#222;font-size:.72rem;letter-spacing:.06em;">
  © <%= new Date().getFullYear() %> HUP Creative — hupcreative.cloud
</footer>

<!-- ════════════════════════════════════════════════
     JS
════════════════════════════════════════════════ -->
<script>
  // ── Scroll reveal ──────────────────────────────
  const revObs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');revObs.unobserve(e.target);}});
  },{threshold:0.06});
  document.querySelectorAll('.reveal').forEach(el=>revObs.observe(el));

  // ── Hero entrance ──────────────────────────────
  document.querySelectorAll('.hero-item').forEach((el,i)=>{
    setTimeout(()=>el.classList.add('visible'), 150 + i * 200);
  });

  // ── Investment block entrance ──────────────────
  const investEl = document.querySelector('.investment-block');
  if(investEl){
    const investObs = new IntersectionObserver(entries=>{
      entries.forEach(e=>{
        if(e.isIntersecting){
          setTimeout(()=>e.target.classList.add('visible'), 100);
          investObs.unobserve(e.target);
        }
      });
    },{threshold:0.1});
    investObs.observe(investEl);
  }

  // ── Budget cards stagger ───────────────────────
  const cardObs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        setTimeout(()=>e.target.classList.add('visible'), parseInt(e.target.dataset.cardIdx||0)*150);
        cardObs.unobserve(e.target);
      }
    });
  },{threshold:0.08});
  document.querySelectorAll('.content-card').forEach(el=>cardObs.observe(el));
</script>
</body>
</html>
