<!-- ════════════════════════════════════════════════
     JS
════════════════════════════════════════════════ -->
<script>
  // ── Vídeos do portfólio (edite aqui para trocar ou adicionar) ──────────────
  // formato: "vertical" (Shorts/Reels) ou "horizontal"
  // preview: caminho opcional de um MP4 curto e mudo para a prévia em movimento
  const videos = [
    // Verticais
    { url: "https://youtube.com/shorts/uELqHbcBTjc", formato: "vertical", legenda: "Frango Esse · Receita", preview: "" },
    { url: "https://youtube.com/shorts/i-JN6owarLc", formato: "vertical", legenda: "Frango Esse · Institucional", preview: "" },
    { url: "https://youtube.com/shorts/sDXe3dnhD3c", formato: "vertical", legenda: "Lançamento linha Real Retrô", preview: "" },
    { url: "https://youtube.com/shorts/Zzp5PolFRmg", formato: "vertical", legenda: "Produção de jujuba", preview: "" },
    { url: "https://youtube.com/shorts/Xpr1Aly4Hk0", formato: "vertical", legenda: "Saltenha", preview: "" },
    { url: "https://youtube.com/shorts/SkAdlKkRb3M", formato: "vertical", legenda: "", preview: "" },
    // Horizontais
    { url: "https://youtu.be/Sd2sb1EdnDw", formato: "horizontal", legenda: "C6 Bank · Jornada Financeira", preview: "" },
    { url: "https://youtu.be/rhkIwlXJXNY", formato: "horizontal", legenda: "TrioDaCultura · Josyara", preview: "" },
    { url: "https://youtu.be/aoCaJO2HoGs", formato: "horizontal", legenda: "Carnaval O Sarapa 2026", preview: "" },
    { url: "https://youtu.be/M89L-h3klVo", formato: "horizontal", legenda: "O Varejão · Inauguração Largo do Tanque", preview: "" },
    { url: "https://youtu.be/Y5jq7w22POc", formato: "horizontal", legenda: "BN Hall · Pós-venda", preview: "" }
  ];

  // Zoom aplicado às thumbs 4:3/16:9 (maxres1-3, sd, hq) nos cards verticais.
  // O object-fit:cover já corta as laterais desfocadas dos Shorts; 1.05 só garante as bordas.
  // Para cortar mais, aumente (ex.: 1.35).
  const HQ_ZOOM_VERTICAL = 1.05;

  const PROPOSAL = <%- JSON.stringify({
    company: proposal.client.company,
    subtitle: proposal.heroSubtitle,
    expires: _expires,
    pdfTitle: proposal.pdfTitle || 'Orcamento-HUP',
    logo: _logoWhite,
    budget: proposal.budget,
    deliverables: proposal.deliverables,
    equipment: proposal.equipment,
    conditions: proposal.conditions,
    approveWhatsapp: proposal.cta.approveWhatsapp,
  }) %>;
  const FOTOS = {
    alimentacao:   <%- JSON.stringify(assets.fotografiaAlimentacao) %>,
    institucional: <%- JSON.stringify(assets.fotografiaInstitucional) %>,
    produto:       <%- JSON.stringify(assets.fotografiaProduto) %>,
  };

  // ── Scroll reveal ──────────────────────────────
  const revObs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');revObs.unobserve(e.target);}});
  },{threshold:0.06});
  document.querySelectorAll('.reveal').forEach(el=>revObs.observe(el));

  // ── Hero entrance ──────────────────────────────
  document.querySelectorAll('.hero-item').forEach((el,i)=>{
    setTimeout(()=>el.classList.add('visible'), 150 + i * 200);
  });

  // ════════════════════════════════════════════════
  //  AUDIOVISUAL — cards com facade (sem iframe até o clique)
  // ════════════════════════════════════════════════
  function ytId(url){
    try{
      const u = new URL(url.trim());
      let id = null;
      if (/(^|\.)youtu\.be$/.test(u.hostname)) id = u.pathname.split('/')[1];
      else if (u.searchParams.get('v')) id = u.searchParams.get('v');
      else { const m = u.pathname.match(/\/(?:shorts|embed|live)\/([^/?#]+)/); if (m) id = m[1]; }
      return id && /^[\w-]{11}$/.test(id) ? id : null;
    }catch(e){ return null; }
  }
  const thumb = (id, name) => `https://i.ytimg.com/vi/${id}/${name}.jpg`;
  // O YouTube responde 404 com uma imagem cinza de 120px: tratamos as duas coisas como falha.
  function loadImg(src){
    return new Promise(resolve=>{
      const im = new Image();
      im.onload = ()=> resolve(im.naturalWidth > 120 ? src : null);
      im.onerror = ()=> resolve(null);
      im.src = src;
    });
  }

  const canHover = window.matchMedia('(hover:hover) and (pointer:fine)').matches;
  let playingCard = null;

  function buildCard(v){
    const id = ytId(v.url);
    if (!id) return null;
    const vertical = v.formato === 'vertical';
    const fig = document.createElement('figure');
    fig.className = 'vcard ' + (vertical ? 'vcard--v' : 'vcard--h');
    fig.dataset.id = id;

    const media = document.createElement('div');
    media.className = 'vcard-media';
    media.style.setProperty('--hq-zoom', HQ_ZOOM_VERTICAL);
    media.tabIndex = 0;
    media.setAttribute('role','button');
    media.setAttribute('aria-label', 'Assistir vídeo' + (v.legenda ? ': ' + v.legenda : ''));

    const cover = document.createElement('img');
    cover.className = 'vcard-cover';
    cover.alt = '';
    cover.decoding = 'async';
    media.appendChild(cover);

    const shade = document.createElement('div');
    shade.className = 'vcard-shade';
    media.appendChild(shade);

    const play = document.createElement('span');
    play.className = 'vcard-play';
    play.setAttribute('aria-hidden','true');
    play.innerHTML = '<svg width="22" height="24" viewBox="0 0 22 24"><path d="M2 2.5v19L20 12z" fill="#0a0a0a"/></svg>';
    media.appendChild(play);
    fig.appendChild(media);

    if (v.legenda) {
      const cap = document.createElement('figcaption');
      cap.className = 'vcard-cap';
      cap.textContent = v.legenda;
      fig.appendChild(cap);
    }

    fig._v = v; fig._id = id; fig._media = media; fig._cover = cover; fig._vertical = vertical;
    return fig;
  }

  // Capa: verticais tentam oar2 → hqdefault (com zoom); horizontais maxresdefault → hqdefault.
  async function loadCover(fig){
    const id = fig._id;
    const chain = fig._vertical
      ? [['oar2',false],['maxres1',true],['sddefault',true],['hqdefault',true]]
      : [['maxresdefault',false],['sddefault',false],['hqdefault',false]];
    for (const [name, zoom] of chain) {
      const ok = await loadImg(thumb(id, name));
      if (ok) {
        fig._cover.src = ok;
        if (zoom) fig._media.classList.add('hq-zoom');
        return true;
      }
    }
    return false;
  }

  // Prévia: MP4 (se houver) ou frames automáticos (1/2/3) em crossfade.
  async function preparePreview(fig){
    if (fig._previewReady) return fig._previewReady;
    fig._previewReady = (async ()=>{
      if (fig._v.preview) {
        const vid = document.createElement('video');
        vid.className = 'vcard-preview';
        vid.muted = true; vid.loop = true; vid.playsInline = true; vid.preload = 'none';
        vid.setAttribute('muted',''); vid.setAttribute('playsinline','');
        vid.src = fig._v.preview;
        fig._media.insertBefore(vid, fig._media.querySelector('.vcard-shade'));
        fig._video = vid;
        return;
      }
      // Frames em HD (1280px) quando existirem; senão 640px; senão 480px.
      const frameSrc = async n => (await loadImg(thumb(fig._id,'maxres'+n))) || (await loadImg(thumb(fig._id,'sd'+n))) || (await loadImg(thumb(fig._id,'hq'+n)));
      const srcs = (await Promise.all([1,2,3].map(frameSrc))).filter(Boolean);
      fig._frames = srcs.map(src=>{
        const im = document.createElement('img');
        im.className = 'vcard-frame'; im.alt = ''; im.src = src;
        fig._media.insertBefore(im, fig._media.querySelector('.vcard-shade'));
        return im;
      });
    })();
    return fig._previewReady;
  }

  async function startPreview(fig){
    if (fig._active || fig === playingCard) return;
    fig._active = true;
    await preparePreview(fig);
    if (!fig._active || fig === playingCard) return;
    if (fig._video) {
      fig._video.classList.add('on');
      fig._video.play().catch(()=>{});
      return;
    }
    const frames = fig._frames || [];
    if (!frames.length) return;
    let i = 0;
    frames[0].classList.add('on');
    clearInterval(fig._timer);
    fig._timer = setInterval(()=>{
      frames[i].classList.remove('on');
      i = (i + 1) % frames.length;
      frames[i].classList.add('on');
    }, 900);
  }

  function stopPreview(fig){
    fig._active = false;
    clearInterval(fig._timer);
    (fig._frames || []).forEach(f=>f.classList.remove('on'));
    if (fig._video) { fig._video.pause(); fig._video.classList.remove('on'); }
  }

  function playVideo(fig){
    if (fig === playingCard) return;
    if (playingCard) resetCard(playingCard);
    stopPreview(fig);
    const ifr = document.createElement('iframe');
    ifr.src = `https://www.youtube-nocookie.com/embed/${fig._id}?autoplay=1&playsinline=1&rel=0&modestbranding=1&vq=hd1080`;
    ifr.title = fig._v.legenda || 'Vídeo HUP Creative';
    ifr.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    ifr.allowFullscreen = true;
    fig._media.appendChild(ifr);
    fig._media.classList.add('playing');
    fig._media.removeAttribute('role');
    fig._media.tabIndex = -1;
    playingCard = fig;
  }

  function resetCard(fig){
    const ifr = fig._media.querySelector('iframe');
    if (ifr) ifr.remove();
    fig._media.classList.remove('playing');
    fig._media.setAttribute('role','button');
    fig._media.tabIndex = 0;
    if (playingCard === fig) playingCard = null;
  }

  // Observers: pré-carrega frames perto da tela; no mobile, prévia com 60% visível.
  const nearObs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{ if (e.isIntersecting) { preparePreview(e.target); nearObs.unobserve(e.target); } });
  },{rootMargin:'300px 300px'});
  const visObs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{ e.isIntersecting ? startPreview(e.target) : stopPreview(e.target); });
  },{threshold:0.6});

  function mountCard(fig, parent){
    parent.appendChild(fig);
    loadCover(fig).then(ok=>{
      if (!ok) { fig.remove(); updateArrows(); return; }
      nearObs.observe(fig);
      if (canHover) {
        fig._media.addEventListener('mouseenter', ()=>startPreview(fig));
        fig._media.addEventListener('mouseleave', ()=>stopPreview(fig));
      } else {
        visObs.observe(fig);
      }
    });
    fig._media.addEventListener('click', ()=>playVideo(fig));
    fig._media.addEventListener('keydown', e=>{
      if ((e.key === 'Enter' || e.key === ' ') && fig !== playingCard) { e.preventDefault(); playVideo(fig); }
    });
  }

  const vTrack = document.getElementById('v-track');
  const hGrid  = document.getElementById('h-grid');
  videos.forEach(v=>{
    const fig = buildCard(v);
    if (fig) mountCard(fig, v.formato === 'vertical' ? vTrack : hGrid);
  });

  // Setas do carrossel vertical
  const vPrev = document.getElementById('v-prev');
  const vNext = document.getElementById('v-next');
  function stepSize(){
    const card = vTrack.querySelector('.vcard');
    return card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(vTrack).columnGap || 14) : vTrack.clientWidth;
  }
  function updateArrows(){
    const max = vTrack.scrollWidth - vTrack.clientWidth - 2;
    vPrev.disabled = vTrack.scrollLeft <= 2;
    vNext.disabled = vTrack.scrollLeft >= max;
  }
  vPrev.addEventListener('click', ()=>vTrack.scrollBy({left:-stepSize(),behavior:'smooth'}));
  vNext.addEventListener('click', ()=>vTrack.scrollBy({left: stepSize(),behavior:'smooth'}));
  vTrack.addEventListener('scroll', updateArrows, {passive:true});
  window.addEventListener('resize', updateArrows);
  updateArrows();

  // ════════════════════════════════════════════════
  //  FOTOGRAFIA — ticker montado via JS (cada foto 1x no HTML; o clone do loop é gerado aqui)
  // ════════════════════════════════════════════════
  FOTOS.all = (()=>{
    const out = [], cats = [FOTOS.alimentacao, FOTOS.institucional, FOTOS.produto];
    const max = Math.max(...cats.map(c=>c.length));
    for (let i = 0; i < max; i++) cats.forEach(c=>{ if (c[i]) out.push(c[i]); });
    return out;
  })();
  const SPEEDS = { all:[187,210,152], alimentacao:[105,88,128], institucional:[128,111,152], produto:[117,140,99] };
  const gallery = document.getElementById('photo-gallery');
  let currentFotos = [];

  function renderGallery(cat){
    const list = FOTOS[cat] || [];
    currentFotos = list;
    const rows = [[],[],[]];
    list.forEach((src,i)=>rows[i % 3].push(src));
    gallery.innerHTML = '';
    [0,2,1].forEach((r, k)=>{
      if (!rows[r].length) return;
      const wrap = document.createElement('div'); wrap.className = 'ticker-wrap';
      const track = document.createElement('div'); track.className = 'ticker-track' + (k === 2 ? ' rev' : '');
      track.style.setProperty('--spd', SPEEDS[cat][k] + 's');
      const imgs = rows[r].map((src,j)=>{
        const im = document.createElement('img');
        im.src = src; im.alt = ''; im.loading = (k === 0 && j < 6) ? 'eager' : 'lazy'; im.dataset.fotosrc = src;
        return im;
      });
      imgs.forEach(im=>track.appendChild(im));
      imgs.forEach(im=>{ const c = im.cloneNode(); c.setAttribute('aria-hidden','true'); track.appendChild(c); });
      wrap.appendChild(track); gallery.appendChild(wrap);
    });
  }
  gallery.addEventListener('click', e=>{
    const img = e.target.closest('[data-fotosrc]');
    if (!img) return;
    const idx = currentFotos.indexOf(img.dataset.fotosrc);
    openLb(currentFotos, idx >= 0 ? idx : 0);
  });
  document.querySelectorAll('#photo-filter-bar .filter-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      if (btn.classList.contains('active')) return;
      document.querySelectorAll('#photo-filter-bar .filter-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      gallery.classList.add('fading');
      setTimeout(()=>{ renderGallery(btn.dataset.pcat); gallery.classList.remove('fading'); }, 200);
    });
  });
  renderGallery((document.querySelector('#photo-filter-bar .filter-btn.active') || {dataset:{pcat:'all'}}).dataset.pcat);

  // ── Lightbox ───────────────────────────────────
  const lb=document.getElementById('lightbox');
  const lbImg=document.getElementById('lb-img');
  const lbCount=document.getElementById('lb-count');
  let lbGal=[],lbIdx=0;
  function openLb(gal,idx){lbGal=gal;lbIdx=idx;lbImg.src=lbGal[lbIdx];lbCount.textContent=(lbIdx+1)+' / '+lbGal.length;lb.classList.add('open');document.body.style.overflow='hidden';}
  function closeLb(){lb.classList.remove('open');document.body.style.overflow='';setTimeout(()=>{lbImg.src='';},300);}
  function lbNav(d){lbIdx=(lbIdx+d+lbGal.length)%lbGal.length;lbImg.src=lbGal[lbIdx];lbCount.textContent=(lbIdx+1)+' / '+lbGal.length;}
  document.getElementById('lb-close').onclick=closeLb;
  lb.addEventListener('click',e=>{if(e.target===lb)closeLb();});
  document.getElementById('lb-prev').onclick=()=>lbNav(-1);
  document.getElementById('lb-next').onclick=()=>lbNav(1);
  document.addEventListener('keydown',e=>{
    if(!lb.classList.contains('open'))return;
    if(e.key==='Escape')closeLb();
    if(e.key==='ArrowLeft')lbNav(-1);
    if(e.key==='ArrowRight')lbNav(1);
  });

  // ════════════════════════════════════════════════
  //  ORÇAMENTO — toggles, quantidade e totais (estado só em memória)
  // ════════════════════════════════════════════════
  const BRL = new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
  const money = n => BRL.format(n).replace(/ /g,' ');
  const ITEMS = PROPOSAL.budget.groups.flatMap(g=>g.items.map(it=>({...it, group:g.name})));
  const EP = PROPOSAL.budget.episodes;
  const state = {
    on: Object.fromEntries(ITEMS.map(it=>[it.id, it.fixed ? true : !!it.on])),
    episodes: EP.default,
  };
  // Desconto por quantidade de episódios (maior faixa atingida vale)
  const DISCOUNTS = (PROPOSAL.budget.discounts || []).slice().sort((a,b)=>b.min - a.min);
  const activeItems   = () => ITEMS.filter(it=>state.on[it.id]);
  const perEpisode    = () => activeItems().reduce((s,it)=>s + it.value, 0);
  const subtotal      = () => perEpisode() * state.episodes;
  const discountPct   = () => (DISCOUNTS.find(d=>state.episodes >= d.min) || {pct:0}).pct;
  const discountValue = () => Math.round(subtotal() * discountPct()) / 100;
  const seriesTotal   = () => subtotal() - discountValue();

  document.querySelectorAll('[data-money]').forEach(el=>{ el.textContent = money(+el.dataset.money); });

  const elEpisode = document.getElementById('sum-episode');
  const elTotal   = document.getElementById('sum-total');
  const elCount   = document.getElementById('ep-count');
  const btnMinus  = document.getElementById('ep-minus');
  const btnPlus   = document.getElementById('ep-plus');
  const btnWa     = document.getElementById('btn-wa');
  const elSubtotal = document.getElementById('sum-subtotal');
  const elDisc     = document.getElementById('sum-disc');
  const elDiscRow  = document.getElementById('sum-disc-row');
  const elSubtotalRow = document.getElementById('sum-subtotal-row');
  const elChip     = document.getElementById('disc-chip');
  const elPer      = document.getElementById('sum-per');
  let shownPct = null;
  let shownTotal = null, countRaf = null;

  function animateTotal(to){
    if (shownTotal === null) { shownTotal = to; elTotal.textContent = money(to); return; }
    const from = shownTotal, t0 = performance.now(), dur = 450;
    cancelAnimationFrame(countRaf);
    const tick = now=>{
      const p = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      const val = Math.round(from + (to - from) * eased);
      elTotal.textContent = money(val);
      shownTotal = val;
      if (p < 1) countRaf = requestAnimationFrame(tick);
      else { shownTotal = to; elTotal.textContent = money(to); }
    };
    countRaf = requestAnimationFrame(tick);
    // Se a aba estiver em segundo plano o rAF pausa: garante o valor final.
    clearTimeout(animateTotal._t);
    animateTotal._t = setTimeout(()=>{ cancelAnimationFrame(countRaf); shownTotal = to; elTotal.textContent = money(to); }, dur + 60);
  }

  function waMessage(){
    const lines = [
      `Olá, José! Quero aprovar o orçamento da série ${PROPOSAL.company}.`,
      '',
      'Itens por episódio:',
      ...activeItems().map(it=>`• ${it.name}: ${money(it.value)}`),
      '',
      `Valor por episódio: ${money(perEpisode())}`,
      `Episódios: ${state.episodes}`,
      ...(discountPct() ? [`Subtotal: ${money(subtotal())}`, `Desconto (${discountPct()}%): -${money(discountValue())}`] : []),
      `Total da série: ${money(seriesTotal())}`,
    ];
    return lines.join('\n');
  }

  function render(){
    ITEMS.forEach(it=>{
      if (it.fixed) return;
      const sw = document.querySelector(`[data-toggle="${it.id}"]`);
      sw.setAttribute('aria-checked', state.on[it.id] ? 'true' : 'false');
      sw.closest('.brow').classList.toggle('off', !state.on[it.id]);
    });
    elEpisode.textContent = money(perEpisode());
    elCount.textContent = state.episodes;
    btnMinus.disabled = state.episodes <= EP.min;
    btnPlus.disabled  = state.episodes >= EP.max;
    const pct = discountPct();
    elSubtotal.textContent = money(subtotal());
    elDisc.textContent = '−' + money(discountValue());
    elDiscRow.classList.toggle('none', !pct);
    elSubtotalRow.classList.toggle('none', !pct);
    elChip.textContent = '−' + pct + '%';
    if (shownPct !== null && pct !== shownPct && pct) { elChip.classList.remove('pop'); void elChip.offsetWidth; elChip.classList.add('pop'); }
    shownPct = pct;
    elPer.textContent = pct ? `Equivale a ${money(seriesTotal() / state.episodes)} por episódio` : '';
    animateTotal(seriesTotal());
    btnWa.href = PROPOSAL.approveWhatsapp + '?text=' + encodeURIComponent(waMessage());
  }

  document.querySelectorAll('[data-toggle]').forEach(sw=>{
    sw.addEventListener('click', ()=>{
      const id = sw.dataset.toggle;
      const item = ITEMS.find(it=>it.id === id);
      const next = !state.on[id];
      // Itens com o mesmo "exclusive" são excludentes: ligar um desliga os outros.
      if (next && item.exclusive) {
        ITEMS.forEach(o=>{ if (o.exclusive === item.exclusive && o.id !== id) state.on[o.id] = false; });
      }
      state.on[id] = next;
      render();
    });
  });
  btnMinus.addEventListener('click', ()=>{ if (state.episodes > EP.min) { state.episodes--; render(); } });
  btnPlus.addEventListener('click',  ()=>{ if (state.episodes < EP.max) { state.episodes++; render(); } });
  render();

  // ════════════════════════════════════════════════
  //  PDF — bloco exclusivo de impressão + window.print()
  // ════════════════════════════════════════════════
  const esc = s => String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const printSheet = document.getElementById('print-sheet');
  let savedTitle = null;

  function buildPrintSheet(){
    const today = new Date().toLocaleDateString('pt-BR');
    const act = activeItems();
    const groups = PROPOSAL.budget.groups
      .map(g=>({ name:g.name, items:g.items.filter(it=>state.on[it.id]) }))
      .filter(g=>g.items.length);
    const rows = groups.map(g=>
      `<tr class="ps-grp"><td colspan="3">${esc(g.name)}</td></tr>` +
      g.items.map(it=>`<tr><td class="c-item">${esc(it.name)}</td><td class="c-desc">${esc(it.short || '')}</td><td class="c-val">${money(it.value)}</td></tr>`).join('')
    ).join('');
    const li = arr => arr.map(x=>`<li>${esc(x)}</li>`).join('');

    printSheet.innerHTML = `
      <table class="ps-layout">
        <tbody><tr><td>
          <header class="ps-header">
            <img src="${esc(PROPOSAL.logo)}" alt="HUP Creative">
            <div class="ps-header-r">
              <h1>Orçamento | ${esc(PROPOSAL.company)}</h1>
              <div class="ps-meta">Emitido em <b>${today}</b> &nbsp;·&nbsp; Válido até <b>${esc(PROPOSAL.expires)}</b></div>
            </div>
          </header>
          <div class="ps-body">
            <p class="ps-intro">${esc(PROPOSAL.subtitle)} · Orçamento por episódio</p>
            <p class="ps-h">Itens por episódio</p>
            <table class="ps-table">
              <thead><tr><th>Item</th><th>Descrição</th><th style="text-align:right">Valor</th></tr></thead>
              <tbody>${rows}</tbody>
            </table>
            <div class="ps-totals${discountPct() ? '' : ' ps-totals--nodisc'}">
              <div><div class="ps-tl">Valor por episódio</div><div class="ps-tv">${money(perEpisode())}</div></div>
              <div><div class="ps-tl">Episódios</div><div class="ps-tv">${state.episodes}</div></div>
              ${discountPct() ? `<div><div class="ps-tl">Subtotal</div><div class="ps-tv">${money(subtotal())}</div></div>
              <div><div class="ps-tl">Desconto ${discountPct()}%</div><div class="ps-tv ps-tv--disc">−${money(discountValue())}</div></div>` : ''}
              <div><div class="ps-tl">Total da série</div><div class="ps-tv ps-tv--big">${money(seriesTotal())}</div>${discountPct() ? `<div class="ps-tsub">${money(seriesTotal() / state.episodes)} por episódio</div>` : ''}</div>
            </div>
            <p class="ps-pay">${esc(PROPOSAL.budget.paymentNote)}</p>
            <div class="ps-cols">
              <div>
                <div class="ps-block"><p class="ps-h">Entregáveis por episódio</p><ul>${li(PROPOSAL.deliverables)}</ul></div>
                <div class="ps-block"><p class="ps-h">Condições</p><ul>${li(PROPOSAL.conditions)}</ul></div>
              </div>
              <div class="ps-block"><p class="ps-h">Equipamentos inclusos</p><ul>${li(PROPOSAL.equipment)}</ul></div>
            </div>
          </div>
        </td></tr></tbody>
        <tfoot><tr><td><div class="ps-foot-space"></div></td></tr></tfoot>
      </table>
      <div class="ps-footer">HUP Creative · jose@hup.com.br · (71) 9 9338-6304 · hup.com.br</div>`;
  }

  function beforePrint(){
    buildPrintSheet();
    if (savedTitle === null) { savedTitle = document.title; document.title = PROPOSAL.pdfTitle; }
  }
  function afterPrint(){
    if (savedTitle !== null) { document.title = savedTitle; savedTitle = null; }
  }
  window.addEventListener('beforeprint', beforePrint);
  window.addEventListener('afterprint', afterPrint);
  document.getElementById('btn-pdf').addEventListener('click', ()=>{
    beforePrint();
    // Garante que a logo do PDF já carregou antes de abrir a impressão.
    const logo = printSheet.querySelector('img');
    const go = ()=>{ window.print(); };
    if (logo && !logo.complete) { logo.onload = logo.onerror = go; } else { go(); }
  });
</script>
</body>
</html>
